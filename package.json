{
  "name": "animal-farm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A model of a farm: an Animal base class, one class per species, and a Farm that keeps them.",
  "scripts": {
    "dev": "vite",
    "proxy": "node --env-file=.env server/decide.js",
    "demo": "node scripts/demo.js",
    "mind": "node scripts/claude-mind.js",
    "check": "node scripts/check.js",
    "probe": "node scripts/probe.js",
    "ui-check": "python .claude/skills/webapp-testing/scripts/with_server.py --server \"npm run dev\" --port 5173 -- python scripts/ui-check.py",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}
