# Template. Copy to .env and fill in — .env is gitignored, this file is not.
#
#   cp .env.example .env
#
# NOTHING READS THESE YET. The farm runs entirely in the browser with no
# server and no configuration, so adding a variable here does not make it
# available to anything. It is scaffolding for the Claude-backed Mind that
# was designed but not built (see src/model/minds/Mind.js).
#
# ⚠ NEVER prefix a secret with VITE_.
#   Vite inlines every VITE_* variable into the client bundle at build time,
#   so it is shipped to every visitor and readable in devtools. A key belongs
#   in a server process the browser talks to — never in the page itself.
#   Variables without the prefix are not exposed to the client, which is why
#   the ones below have none.

# Anthropic API key, for a Claude-backed Mind deciding animals' goals.
# Server-side only. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which model that Mind should use.
ANTHROPIC_MODEL=claude-opus-5

# Port for the proxy that would hold the key and serve /decide to the browser.
PORT=8787
